# Server
NODE_ENV=development
# Carton QR delivery. Default OFF; requires the additive migration before activation.
# Never put encryption keys in VITE_ variables, logs or source control.
CARTON_DELIVERY_ENABLED=false
CARTON_DELIVERY_PUBLIC_ORIGIN=
CARTON_DELIVERY_ACTIVE_KEY=
# JSON object of key-version -> canonical base64-encoded 32-byte AES keys.
# Retain all previous versions used by printed labels when rotating the active key.
CARTON_DELIVERY_KEYS=
CARTON_DELIVERY_VALIDITY_DAYS=180
# Phase 1A: permits confirmed Live settings activation only; default false.
# Does not authorize or execute paid lookups or government filing.
GST_COMPLIANCE_LIVE_AUTHORIZED=false

# GSTIN verification: backend only; fixed origin https://www.gstinapi.in.
# Empty key means provider-backed checks cannot run. Never use VITE_ for secrets.
# The same key and timeout also serve the Accountant-only "Today's Usage" statistics
# (GET /gst-compliance/usage), which are free and independent of the flags below.
GST_VERIFICATION_API_KEY=
# Independent paid-lookup authorization, default OFF.
GST_VERIFICATION_LIVE_LOOKUP_AUTHORIZED=false
# Timeout 1000..30000 ms; TTL 60..2592000 seconds, default seven days.
GST_VERIFICATION_TIMEOUT_MS=10000
GST_VERIFICATION_BASIC_TTL_SECONDS=604800
GST_VERIFICATION_COMPLETE_TTL_SECONDS=604800
# E-Way Bill provider adapter (Demo only; reuses GST_VERIFICATION_API_KEY).
# Portal credentials are the E-Way Bill API user for the acting GSTIN ("For GSP"),
# sent per request, never stored or logged. Whether Demo calls need them is
# unconfirmed. Timeout 1000..60000 ms.
EWAY_BILL_TIMEOUT_MS=20000
# Permits synthetic (provider test_mode) E-Way Bill generation on this server.
# Defaults to false; leave false unless a Demo test is intended. It never
# enables Live filing, which does not exist.
EWAY_BILL_DEMO_GENERATION_AUTHORIZED=false
EWAY_BILL_PORTAL_USERNAME=
EWAY_BILL_PORTAL_PASSWORD=
# Durable limits: 10 confirmation intents/actor/minute;
# 5 execution claims/actor/minute and 30 globally/minute. No automatic retries.
# Interface to bind to. Defaults to all interfaces for local development;
# production should set this to 127.0.0.1 since Nginx is the only public
# entry point and the API must never be reachable directly.
HOST=0.0.0.0
PORT=4000

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erve_dev?schema=public"
# Required only by the destructive integration suite. It must be disposable,
# contain a standalone `test` marker, and differ from DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erve_test?schema=public"

# Required only by `historical-import:dev-migrate` (apps/api/src/cli/
# historical-import-dev-migrate.cli.ts). The operator's one-time, explicit
# declaration of exactly which database that command is allowed to apply
# the additive historical-import schema migration to. Usually the same
# value as DATABASE_URL. That command refuses to run if this is unset, or
# if it doesn't exactly match DATABASE_URL at run time — it never infers or
# guesses "this looks like Dev".
HISTORICAL_IMPORT_EXPECTED_DEV_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erve_dev?schema=public"

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-random-32+-character-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-32+-character-secret"
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_IDLE_TIMEOUT_MINUTES=20
JWT_REFRESH_ABSOLUTE_TIMEOUT_HOURS=8

# CORS — comma-separated exact-match allowlist (no wildcards, no prefix
# matching). http://localhost:5173 is the web Vite dev server.
# http://localhost:5174 is the mobile app's Capacitor live-reload dev flow
# (`cap:run:android:live` / `pnpm cap:run:android:live`), which serves the
# WebView content from the Vite dev server over plain HTTP instead of the
# packaged app's bundled origin.
# https://localhost is the Capacitor Android WebView origin for a packaged
# debug build (observed via WebView remote debugging / console — see
# CAPACITOR_AUTH_TESTING.md).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://localhost

# File storage (uploaded style images).
# FILE_STORAGE_DRIVER: only "local" is implemented today.
# FILE_STORAGE_DIR: persistent root for uploads. Relative paths resolve
# against apps/api (the development default ".data/uploads" is gitignored).
# Production MUST set an explicit absolute path outside the versioned
# release directories — the recommended location is
# <DEPLOY_ROOT>/shared/uploads, which deployments and release cleanup never
# touch (see DEPLOYMENT.md).
FILE_STORAGE_DRIVER=local
FILE_STORAGE_DIR=.data/uploads
# Maximum accepted image upload size in bytes (default 5 MiB).
UPLOAD_MAX_IMAGE_BYTES=5242880
