  execution   QualityActivityExecution @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "quality_corrective_actions_execution_id_fkey")

  @@index([executionId, componentId], map: "quality_corrective_action_idx")
