enum QaInspectionStatus {
  DRAFT
  FINALIZED
  REOPENED
  VOIDED
}

enum QaDefectCategory {
  STITCHING
  FABRIC
  PRINT_EMBROIDERY
  MEASUREMENT
  FINISHING
  PACKAGING
  OTHER
}

enum QaReworkStatus {
  REWORK_REQUIRED
  ACKNOWLEDGED
  READY_FOR_REINSPECTION
  REINSPECTED
}

// These are the three marked columns on the supplied sample checklist. A
// missing value deliberately represents an unanswered draft item; it is not a
// fabricated pass/fail default.
enum QaChecklistStatus {
  YES
  NO
  AVAILABLE
}

model JobOrderIdempotencyRecord {
  id             String   @id
  actorId        String   @map("actor_id")
  jobOrderId     String   @map("job_order_id")
  operation      String
  idempotencyKey String   @map("idempotency_key")
  requestHash    String   @map("request_hash")
  resultVersion  Int      @map("result_version")
  createdAt      DateTime @default(now()) @map("created_at")

  jobOrder JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  @@unique([actorId, operation, idempotencyKey], map: "job_order_idempotency_records_actor_id_operation_idempotency_ke")
  @@index([jobOrderId])
  @@map("job_order_idempotency_records")
}

model JobOrderLine {
  id                    String         @id
  jobOrderId            String         @map("job_order_id")
  purchaseOrderLineId   String         @map("purchase_order_line_id")
  styleId               String         @map("style_id")
  orderedQuantityTotal  Int            @map("ordered_quantity_total")
  preparedQuantityTotal Int            @default(0) @map("prepared_quantity_total")
  status                JobOrderStatus @default(DRAFT)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  jobOrder          JobOrder                     @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  purchaseOrderLine DistributorPurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  style             Style                        @relation(fields: [styleId], references: [id], onDelete: Restrict)
  sizes             JobOrderLineSize[]

  @@unique([jobOrderId, purchaseOrderLineId])
  @@index([jobOrderId])
  @@index([purchaseOrderLineId])
  @@index([styleId])
  @@map("job_order_lines")
}

model JobOrderLineSize {
  id                      String   @id
  jobOrderLineId          String   @map("job_order_line_id")
  purchaseOrderLineSizeId String   @map("purchase_order_line_size_id")
  sizeId                  String   @map("size_id")
  orderedQuantity         Int      @map("ordered_quantity")
  preparedQuantity        Int      @default(0) @map("prepared_quantity")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  jobOrderLine                 JobOrderLine                     @relation(fields: [jobOrderLineId], references: [id], onDelete: Cascade)
  purchaseOrderLineSize        DistributorPurchaseOrderLineSize @relation(fields: [purchaseOrderLineSizeId], references: [id], onDelete: Restrict)
  size                         Size                             @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  qaSizeInspectionForms        QaSizeInspectionForm[]
  qaReworkTasks                QaReworkTask[]
  qualitySampleExecutions      QualityActivityExecution[]       @relation("QualityExecutionSampleSize")
  finalQualityBatchAllocations FinalQualityBatchAllocation[]
  qaReleaseLines               QaReleaseLine[]

  @@unique([jobOrderLineId, purchaseOrderLineSizeId])
  @@index([jobOrderLineId])
  @@index([purchaseOrderLineSizeId])
  @@index([sizeId])
  @@map("job_order_line_sizes")
}

// A session records the shared inspection cycle and lifecycle only. Every size
// inspected in that cycle has its own complete form below.
model QaInspectionSession {
  id                         String             @id
  jobOrderId                 String             @map("job_order_id")
  inspectorId                String             @map("inspector_id")
  cycleNumber                Int                @map("cycle_number")
  status                     QaInspectionStatus @default(DRAFT)
  version                    Int                @default(1)
  finalizedAt                DateTime?          @map("finalized_at")
  reopenedAt                 DateTime?          @map("reopened_at")
  reopenedById               String?            @map("reopened_by_id")
  reopenReason               String?            @map("reopen_reason")
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")
  qualityActivityExecutionId String?            @unique(map: "qa_inspection_sessions_quality_execution_key") @map("quality_activity_execution_id")

  jobOrder                 JobOrder                  @relation(fields: [jobOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inspector                User                      @relation("QaInspector", fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reopenedBy               User?                     @relation("QaReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  forms                    QaSizeInspectionForm[]
  evidence                 QaEvidence[]
  qualityActivityExecution QualityActivityExecution? @relation(fields: [qualityActivityExecutionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "qa_inspection_sessions_quality_execution_fkey")

  @@index([jobOrderId, status])
  @@index([inspectorId])
  @@map("qa_inspection_sessions")
}

model QaSizeInspectionChecklistItem {
  id               String             @id
  inspectionFormId String             @map("inspection_form_id")
  itemCode         String             @map("item_code")
  status           QaChecklistStatus?
  remarks          String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  form QaSizeInspectionForm @relation(fields: [inspectionFormId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([inspectionFormId, itemCode], map: "qa_size_inspection_checklist_i_inspection_form_id_item_code_key")
  @@index([inspectionFormId])
  @@map("qa_size_inspection_checklist_items")
}

// One complete paper-equivalent QA form for one JobOrderLineSize in a session.
// DRAFT forms reserve quantities. FINALIZED forms are authoritative.
model QaSizeInspectionForm {
  id                          String             @id
  inspectionSessionId         String             @map("inspection_session_id")
  jobOrderLineSizeId          String             @map("job_order_line_size_id")
  sourceReworkTaskId          String?            @map("source_rework_task_id")
  sampleQuantity              Int?               @map("sample_quantity")
  inspectionRemarks           String?            @map("inspection_remarks")
  status                      QaInspectionStatus @default(DRAFT)
  finalizedAt                 DateTime?          @map("finalized_at")
  reopenedAt                  DateTime?          @map("reopened_at")
  reopenedById                String?            @map("reopened_by_id")
  reopenReason                String?            @map("reopen_reason")
  version                     Int                @default(1)
  inspectedQuantity           Int                @map("inspected_quantity")
  acceptedQuantity            Int                @map("accepted_quantity")
  reworkQuantity              Int                @map("rework_quantity")
  permanentlyRejectedQuantity Int                @map("permanently_rejected_quantity")
  defectCategory              QaDefectCategory?  @map("defect_category")
  otherDefectDetails          String?            @map("other_defect_details")
  defectNotes                 String?            @map("defect_notes")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")

  session          QaInspectionSession             @relation(fields: [inspectionSessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobOrderLineSize JobOrderLineSize                @relation(fields: [jobOrderLineSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceReworkTask QaReworkTask?                   @relation("QaReinspectionSource", fields: [sourceReworkTaskId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  generatedRework  QaReworkTask?                   @relation("QaGeneratedRework")
  checklist        QaSizeInspectionChecklistItem[]
  reopenedBy       User?                           @relation("QaSizeFormReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  evidence         QaEvidence[]

  @@unique([inspectionSessionId, jobOrderLineSizeId])
  // Uniqueness is enforced by the custom COALESCE expression index in
  // 20260729160000_add_qa_workflow so null source IDs are treated as equal.
  @@index([jobOrderLineSizeId])
  @@index([sourceReworkTaskId])
  @@index([inspectionSessionId, status], map: "qa_size_inspection_forms_session_status_idx")
  @@index([reopenedById])
  @@map("qa_size_inspection_forms")
}

model QaReworkTask {
  id                 String         @id
  jobOrderId         String         @map("job_order_id")
  jobOrderLineSizeId String         @map("job_order_line_size_id")
  sourceLineId       String         @unique @map("source_line_id")
  attemptNumber      Int            @map("attempt_number")
  assignedQuantity   Int            @map("assigned_quantity")
  status             QaReworkStatus @default(REWORK_REQUIRED)
  acknowledgedById   String?        @map("acknowledged_by_id")
  acknowledgedAt     DateTime?      @map("acknowledged_at")
  readyById          String?        @map("ready_by_id")
  readyAt            DateTime?      @map("ready_at")
  notes              String?
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  jobOrder         JobOrder               @relation(fields: [jobOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobOrderLineSize JobOrderLineSize       @relation(fields: [jobOrderLineSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceLine       QaSizeInspectionForm   @relation("QaGeneratedRework", fields: [sourceLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reinspections    QaSizeInspectionForm[] @relation("QaReinspectionSource")
  acknowledgedBy   User?                  @relation("QaReworkAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  readyBy          User?                  @relation("QaReworkReadiedBy", fields: [readyById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([jobOrderLineSizeId, attemptNumber])
  @@index([jobOrderId, status])
  @@map("qa_rework_tasks")
}

model QaEvidence {
  id                  String   @id
  inspectionSessionId String   @map("inspection_session_id")
  inspectionLineId    String?  @map("inspection_line_id")
  fileId              String   @map("file_id")
  checksumSha256      String   @map("checksum_sha256")
  createdAt           DateTime @default(now()) @map("created_at")

  session QaInspectionSession   @relation(fields: [inspectionSessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  form    QaSizeInspectionForm? @relation(fields: [inspectionLineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file    File                  @relation(fields: [fileId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([inspectionSessionId, inspectionLineId, checksumSha256], map: "qa_evidence_inspection_session_id_inspection_line_id_checksum_s")
  @@index([inspectionLineId])
  @@index([fileId])
  @@map("qa_evidence")
}

model JobOrderStageStatus {
  id                        String                @id
  jobOrderId                String                @map("job_order_id")
  processFlowVersionStageId String                @map("process_flow_version_stage_id")
  stageSequence             Int                   @map("stage_sequence")
  stageNameSnapshot         String                @map("stage_name_snapshot")
  status                    ProductionStageStatus @default(NOT_STARTED)
  // Compatibility storage for legacy/future generic progress policies. The supported Factory
  // production workflow is state-only and does not write or expose this value.
  completedQuantity         Int?                  @map("completed_quantity")
  completedBy               String?               @map("completed_by")
  completedAt               DateTime?             @map("completed_at")
  remarks                   String?
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")

  jobOrder                JobOrder                @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  processFlowVersionStage ProcessFlowVersionStage @relation(fields: [processFlowVersionStageId], references: [id], onDelete: Restrict)
  completer               User?                   @relation("JobOrderStageCompleter", fields: [completedBy], references: [id], onDelete: SetNull)

  @@unique([jobOrderId, processFlowVersionStageId])
  @@index([jobOrderId])
  @@index([processFlowVersionStageId])
  @@index([status])
  @@map("job_order_stage_statuses")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model File {
  id             String   @id
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  storageKey     String   @map("storage_key")
  // SHA-256 of the stored bytes — lets a retried/duplicated upload of the
  // same content be answered with the existing record instead of creating
  // a duplicate style image.
  checksumSha256 String?  @map("checksum_sha256")
  url            String?
  uploadedById   String?  @map("uploaded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  uploadedBy         User?               @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  styleImages        StyleImage[]
  qaEvidence         QaEvidence[]
  qualityAttachments QualityAttachment[]

  @@index([storageKey])
  @@index([uploadedById])
  @@map("files")
}
