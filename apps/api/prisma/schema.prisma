generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Transporter delivery access is out of scope for this enum in the MVP — it
// will be handled via secure, tokenized public delivery links, not a normal
// logged-in role.
enum RoleName {
  ADMIN
  MERCHANDISER
  FACTORY_USER
  QA_USER
  ACCOUNTANT
  DISTRIBUTOR
  SENIOR_MANAGEMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DistributorStatus {
  ACTIVE
  INACTIVE
}

enum FactoryStatus {
  ACTIVE
  INACTIVE
}

enum StyleStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

// Sizes are individual values (one row per size), not ranges — a style's
// valid sizes are the set of Size rows linked to it via StyleSize.
enum SizeType {
  AGE
  ALPHA
  NUMERIC
  WAIST
  FREE_SIZE
}

enum SizeStatus {
  ACTIVE
  INACTIVE
}

enum StyleSizeStatus {
  ACTIVE
  INACTIVE
}

enum StyleFactoryMappingStatus {
  ACTIVE
  INACTIVE
}

enum PriceListStatus {
  DRAFT
  ACTIVE
  EXPIRED
}

enum PurchaseMode {
  OUTRIGHT
  SALE_RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PARTIALLY_JOB_ORDERED
  FULLY_JOB_ORDERED
  PARTIALLY_FULFILLED
  FULLY_FULFILLED
  CLOSED
  CANCELLED
}

enum PurchaseOrderLineStatus {
  ACTIVE
  CANCELLED
}

enum ProcessFlowStatus {
  ACTIVE
  INACTIVE
}

// DRAFT versions may be edited freely. Once a version is ACTIVE or RETIRED,
// application logic must treat it as immutable (no stage edits/inserts) —
// create a new version instead.
enum ProcessFlowVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ProcessStageStatus {
  ACTIVE
  INACTIVE
}

enum ProcessFlowActivityType {
  PRODUCTION
  QUALITY
}

enum QualityExecutionMode {
  SEQUENTIAL_GATE
  IN_PROCESS
}

enum QualityAvailabilityPolicy {
  WHILE_ASSOCIATED_ACTIVITY_ACTIVE
  AFTER_ASSOCIATED_ACTIVITY_COMPLETES
  PROGRESS_PERCENTAGE
}

enum QualityGateSatisfactionRequirement {
  FINALIZED
  OUTCOME_PASS
}

enum QualityExecutionMultiplicity {
  SINGLE
  BATCHED
}

enum QualityCoverageTarget {
  PREPARED_QUANTITY
}

enum QualityFormStatus {
  ACTIVE
  INACTIVE
}

enum QualityFormActivityType {
  MEETING
  INSPECTION
}

enum QualityFormExecutionScope {
  JOB_ORDER
  SIZE
}

// Published definitions are immutable. A changed definition is always a new
// numbered draft so future workflows can safely retain an exact version.
enum QualityFormVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum QualityFormComponentType {
  SYSTEM_CONTEXT
  FIELD_GROUP
  ATTENDEE_LIST
  ACTION_LIST
  CHECKLIST
  AQL_RESULT
  PRODUCTION_PROGRESS
  DEFECT_LIST
  CORRECTIVE_ACTIONS
  TEST_RESULTS
  COMMENTS
  ATTACHMENTS
  SIGNATURES
  QUANTITY_RECONCILIATION
  INSPECTION_OUTCOME
}

enum QualityActivityExecutionStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum QualityInspectionOutcome {
  PASS
  FAIL
}

enum FinalQualityBatchDisposition {
  DRAFT
  AWAITING_REINSPECTION
  RELEASED
  PERMANENTLY_REJECTED
  CANCELLED
}

// Factory corrective-action lifecycle for one failed Final inspection cycle
// on a physical FinalQualityBatch. Each FAIL creates the next cycle; the
// batch itself stays AWAITING_REINSPECTION throughout — this enum tracks who
// is responsible for the next action, not a duplicate of batch disposition.
enum FinalQualityBatchReworkStatus {
  REQUIRED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
}

enum QualityDefectSeverity {
  CRITICAL
  MAJOR
  MINOR
}

enum JobOrderStatus {
  DRAFT
  SENT_TO_FACTORY
  CONFIRMED_BY_FACTORY
  IN_PRODUCTION
  PRODUCTION_COMPLETE
  READY_FOR_QA
  QA_IN_PROGRESS
  REWORK_REQUIRED
  READY_FOR_REINSPECTION
  QA_APPROVED
  QA_PASSED
  PARTIALLY_QA_PASSED
  CLOSED
  CANCELLED
}

enum FactoryConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ProductionStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ---------------------------------------------------------------------------
// Authentication & Access
// ---------------------------------------------------------------------------

model User {
  id           String     @id
  email        String     @unique
  mobile       String?    @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  // Bumped on security-sensitive credential resets (e.g. admin password
  // reset) so that access/refresh tokens issued before the bump — which
  // carry the prior value in their claims — are rejected immediately,
  // independent of the token's own expiry or the refresh session table.
  authVersion  Int        @default(1) @map("auth_version")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userRoles                            UserRole[]
  userDistributors                     UserDistributor[]
  userFactories                        UserFactory[]
  uploadedFiles                        File[]                     @relation("FileUploadedBy")
  auditLogs                            AuditLog[]                 @relation("AuditLogActor")
  refreshSessions                      RefreshSession[]
  createdPurchaseOrders                DistributorPurchaseOrder[] @relation("POCreator")
  merchandisedPurchaseOrders           DistributorPurchaseOrder[] @relation("POMerchandiser")
  createdJobOrders                     JobOrder[]                 @relation("JobOrderCreator")
  confirmedJobOrders                   JobOrder[]                 @relation("JobOrderConfirmer")
  jobOrderAcknowledgements             JobOrderAcknowledgement[]  @relation("JobOrderAcknowledgedBy")
  completedJobOrderStages              JobOrderStageStatus[]      @relation("JobOrderStageCompleter")
  qaInspections                        QaInspectionSession[]      @relation("QaInspector")
  reopenedQaInspections                QaInspectionSession[]      @relation("QaReopenedBy")
  reopenedQaSizeForms                  QaSizeInspectionForm[]     @relation("QaSizeFormReopenedBy")
  acknowledgedQaReworks                QaReworkTask[]             @relation("QaReworkAcknowledgedBy")
  readiedQaReworks                     QaReworkTask[]             @relation("QaReworkReadiedBy")
  startedQualityExecutions             QualityActivityExecution[] @relation("QualityExecutionStarter")
  finalizedQualityExecutions           QualityActivityExecution[] @relation("QualityExecutionFinalizer")
  qualitySignoffs                      QualitySignoff[]           @relation("QualitySignoffRecorder")
  createdFinalQualityBatches           FinalQualityBatch[]        @relation("FinalQualityBatchCreator")
  terminalFinalQualityBatches          FinalQualityBatch[]        @relation("FinalQualityBatchTerminalActor")
  acknowledgedFinalBatchReworks        FinalQualityBatchRework[]  @relation("FinalBatchReworkAcknowledgedBy")
  startedFinalBatchReworks             FinalQualityBatchRework[]  @relation("FinalBatchReworkStartedBy")
  completedFinalBatchReworks           FinalQualityBatchRework[]  @relation("FinalBatchReworkCompletedBy")
  qaReleases                           QaRelease[]                @relation("QaReleaseActor")
  createdSaleOrders                    SaleOrder[]                @relation("SaleOrderCreator")
  reviewedSaleOrders                   SaleOrder[]                @relation("SaleOrderReviewer")
  fulfilledSaleOrders                  SaleOrder[]                @relation("SaleOrderFulfiller")
  allocatedStockAllocations            StockAllocation[]          @relation("StockAllocationAllocator")
  releasedStockAllocations             StockAllocation[]          @relation("StockAllocationReleaser")
  preparedFactoryDispatches            FactoryDispatch[]          @relation("FactoryDispatchPreparer")
  finalizedFactoryDispatches           FactoryDispatch[]          @relation("FactoryDispatchFinalizer")
  createdErvePackingLists              ErvePackingList[]          @relation("ErvePackingListCreator")
  dispatchedErveDispatches             ErveDispatch[]             @relation("ErveDispatchDispatcher")
  lrUpdatedErveDispatches              ErveDispatch[]             @relation("ErveDispatchLrUpdater")
  deliveredErveDispatches              ErveDispatch[]             @relation("ErveDispatchDeliveryConfirmer")
  recordedInvoiceHandoffs              InvoiceHandoff[]           @relation("InvoiceHandoffRecordedBy")
  submittedDistributorSalesReports     DistributorSalesReport[]   @relation("DistributorSalesReportSubmitter")
  submittedDistributorReturns          DistributorReturn[]        @relation("DistributorReturnSubmitter")
  approvedDistributorReturns           DistributorReturn[]        @relation("DistributorReturnApprover")
  receivedDistributorReturns           DistributorReturn[]        @relation("DistributorReturnReceiver")
  cancelledDistributorReturns          DistributorReturn[]        @relation("DistributorReturnCanceller")
  creditNoteRecordedDistributorReturns DistributorReturn[]        @relation("DistributorReturnCreditNoteRecorder")

  @@index([status])
  @@map("users")
}

model RefreshSession {
  id                String    @id
  userId            String    @map("user_id")
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  lastUsedAt        DateTime  @map("last_used_at")
  idleExpiresAt     DateTime  @map("idle_expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

model Role {
  id          String   @id
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Distributor {
  id           String            @id
  code         String            @unique
  name         String
  gstin        String
  contactName  String?           @map("contact_name")
  contactEmail String?           @map("contact_email")
  contactPhone String?           @map("contact_phone")
  addressLine1 String?           @map("address_line1")
  addressLine2 String?           @map("address_line2")
  city         String?
  state        String?
  country      String?
  postalCode   String?           @map("postal_code")
  status       DistributorStatus @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  userDistributors   UserDistributor[]
  priceLists         PriceList[]
  purchaseOrders     DistributorPurchaseOrder[]
  saleOrders         SaleOrder[]
  erveDispatches     ErveDispatch[]
  salesReports       DistributorSalesReport[]
  distributorReturns DistributorReturn[]

  @@index([status])
  @@map("distributors")
}

model Factory {
  id           String        @id
  code         String        @unique
  name         String
  contactName  String?       @map("contact_name")
  contactEmail String?       @map("contact_email")
  contactPhone String?       @map("contact_phone")
  addressLine1 String?       @map("address_line1")
  addressLine2 String?       @map("address_line2")
  city         String?
  state        String?
  country      String?
  postalCode   String?       @map("postal_code")
  status       FactoryStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  userFactories        UserFactory[]
  styleFactoryMappings StyleFactoryMapping[]
  jobOrders            JobOrder[]
  factoryDispatches    FactoryDispatch[]

  @@index([status])
  @@map("factories")
}

// A distributor user belongs to exactly one distributor: distributor
// isolation (PO visibility, distributor master reads) is scoped to that
// single mapping, so the unique constraint on user_id is load-bearing.
model UserDistributor {
  id            String   @id
  userId        String   @unique @map("user_id")
  distributorId String   @map("distributor_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@map("user_distributors")
}

// A factory user belongs to exactly one factory: factory isolation (Job
// Order visibility, production/QA scoping) is scoped to that single mapping,
// so the unique constraint on user_id is load-bearing — mirrors
// UserDistributor above.
model UserFactory {
  id        String   @id
  userId    String   @unique @map("user_id")
  factoryId String   @map("factory_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId])
  @@map("user_factories")
}

// ---------------------------------------------------------------------------
// Financial Year
// ---------------------------------------------------------------------------

// Financial Year is the sole authority for the 1-Apr–31-Mar fiscal boundary.
// Rows are historical reference data: once created, startDate/endDate must
// never change (see financial-year.service.ts's create-or-validate
// ensureFinancialYear). Every applicable business document and Season
// resolves to exactly one row via its own effective date — never inherited
// through a parent/lineage relationship. Overlap is prevented at the database
// level (see the migration's exclusion constraint), mirroring the
// PriceList non-overlapping-active-period precedent.
model FinancialYear {
  id        String   @id
  code      String   @unique // "2026-27"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seasons            Season[]
  purchaseOrders     DistributorPurchaseOrder[]
  jobOrders          JobOrder[]
  saleOrders         SaleOrder[]
  documentSequences  DocumentSequence[]
  factoryDispatches  FactoryDispatch[]
  ervePackingLists   ErvePackingList[]
  erveDispatches     ErveDispatch[]
  distributorReturns DistributorReturn[]

  @@map("financial_years")
}

enum DocumentType {
  PURCHASE_ORDER
  JOB_ORDER
  SALE_ORDER
  FACTORY_DISPATCH
  ERVE_PACKING_LIST
  ERVE_DISPATCH
  DISTRIBUTOR_RETURN
}

// Append-only high-water mark for (documentType, financialYearId) serial
// allocation. A MAX(existing serial) generator is unsafe here because a DRAFT
// Purchase Order's Financial Year can change (its poDate is editable pre-
// submission) — this table is what guarantees a vacated serial from such a
// move is never reissued.
model DocumentSequence {
  id                  String       @id
  documentType        DocumentType @map("document_type")
  financialYearId     String       @map("financial_year_id")
  lastAllocatedSerial Int          @default(0) @map("last_allocated_serial")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)

  @@unique([documentType, financialYearId])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Master Data
// ---------------------------------------------------------------------------

model Style {
  id                  String      @id
  styleNumber         String      @unique @map("style_number")
  styleName           String      @map("style_name")
  description         String?
  categoryDescription String?     @map("category_description")
  itemNameGroup       String?     @map("item_name_group")
  ipName              String?     @map("ip_name")
  licensor            String?
  colour              String?
  lmixNumber          String?     @map("lmix_number")
  hsnCode             String?     @map("hsn_code")
  hsnDescription      String?     @map("hsn_description")
  finalMrp            Decimal     @map("final_mrp") @db.Decimal(12, 2)
  royaltyPercentage   Decimal?    @map("royalty_percentage") @db.Decimal(5, 2)
  status              StyleStatus @default(ACTIVE)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  images               StyleImage[]
  styleSizes           StyleSize[]
  styleFactoryMappings StyleFactoryMapping[]
  priceListLines       PriceListLine[]
  purchaseOrderLines   DistributorPurchaseOrderLine[]
  jobOrderLines        JobOrderLine[]
  styleSeasons         StyleSeason[]

  @@index([status])
  @@map("styles")
}

// Season names are administrator-managed master data. Season belongs to
// exactly one Financial Year (a real relation, not free text) — the compact
// two-year display form (e.g. 26-27) is derived from FinancialYear.code for
// display, never duplicated in storage.
model Season {
  id              String   @id
  code            String
  name            String
  financialYearId String   @map("financial_year_id")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  styleSeasons  StyleSeason[]

  @@index([status])
  @@map("seasons")
}

model StyleSeason {
  styleId  String @map("style_id")
  seasonId String @map("season_id")

  style  Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@id([styleId, seasonId])
  @@index([seasonId])
  @@map("style_seasons")
}

// A raw partial unique index in the migrations
// (style_images_one_primary_per_style: UNIQUE ON (style_id) WHERE
// is_primary = true) guarantees at most one primary image per style at the
// database level, independent of the service's per-style advisory lock.
model StyleImage {
  id        String   @id
  styleId   String   @map("style_id")
  fileId    String   @map("file_id")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)
  file  File  @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([styleId])
  @@index([fileId])
  @@map("style_images")
}

model Size {
  id        String     @id
  code      String     @unique
  label     String
  sizeType  SizeType   @map("size_type")
  sortOrder Int        @map("sort_order")
  status    SizeStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  styleSizes             StyleSize[]
  purchaseOrderLineSizes DistributorPurchaseOrderLineSize[]
  jobOrderLineSizes      JobOrderLineSize[]

  @@index([status])
  @@index([sizeType])
  @@map("sizes")
}

model StyleSize {
  id                     String          @id
  styleId                String          @map("style_id")
  sizeId                 String          @map("size_id")
  // Optional import/display metadata only (e.g. "3-8 YEARS" from an
  // imported sheet) — the actual valid-size model is this row existing,
  // not this label.
  importedSizeRangeLabel String?         @map("imported_size_range_label")
  status                 StyleSizeStatus @default(ACTIVE)
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)
  size  Size  @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([styleId, sizeId])
  @@index([styleId])
  @@index([sizeId])
  @@map("style_sizes")
}

model StyleFactoryMapping {
  id             String                    @id
  styleId        String                    @map("style_id")
  factoryId      String                    @map("factory_id")
  exFactoryPrice Decimal                   @map("ex_factory_price") @db.Decimal(12, 2)
  status         StyleFactoryMappingStatus @default(ACTIVE)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  style   Style   @relation(fields: [styleId], references: [id], onDelete: Cascade)
  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Restrict)

  @@unique([styleId, factoryId])
  @@index([styleId])
  @@index([factoryId])
  @@map("style_factory_mappings")
}

// A price list is always distributor-specific (what Erve charges that
// distributor) — there is no generic/global price list, so distributorId is
// required and deletion is restricted to preserve pricing history.
// Effective dates are day-granular (@db.Date) so "the applicable price for a
// transaction date" is deterministic; a raw exclusion constraint in the
// migration (price_lists_no_overlapping_active_periods) guarantees at most
// one ACTIVE list per distributor covers any given date.
model PriceList {
  id            String          @id
  code          String          @unique
  name          String
  distributorId String          @map("distributor_id")
  effectiveFrom DateTime?       @map("effective_from") @db.Date
  effectiveTo   DateTime?       @map("effective_to") @db.Date
  status        PriceListStatus @default(DRAFT)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  distributor Distributor     @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  lines       PriceListLine[]

  @@index([distributorId])
  @@index([status])
  @@map("price_lists")
}

model PriceListLine {
  id          String   @id
  priceListId String   @map("price_list_id")
  styleId     String   @map("style_id")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  currency    String   @default("INR")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  style     Style     @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@unique([priceListId, styleId])
  @@index([priceListId])
  @@index([styleId])
  @@map("price_list_lines")
}

// ---------------------------------------------------------------------------
// Process Flow
// ---------------------------------------------------------------------------

model ProcessFlow {
  id          String            @id
  code        String            @unique
  name        String
  description String?
  status      ProcessFlowStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  versions ProcessFlowVersion[]

  @@index([status])
  @@map("process_flows")
}

model ProcessFlowVersion {
  id            String                   @id
  processFlowId String                   @map("process_flow_id")
  versionNumber Int                      @map("version_number")
  status        ProcessFlowVersionStatus @default(DRAFT)
  effectiveFrom DateTime?                @map("effective_from")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  processFlow ProcessFlow               @relation(fields: [processFlowId], references: [id], onDelete: Cascade)
  stages      ProcessFlowVersionStage[]
  jobOrders   JobOrder[]

  @@unique([processFlowId, versionNumber])
  @@index([processFlowId])
  @@index([status])
  @@map("process_flow_versions")
}

model ProcessFlowVersionStage {
  id                             String                              @id
  processFlowVersionId           String                              @map("process_flow_version_id")
  sequence                       Int
  name                           String
  code                           String?
  status                         ProcessStageStatus                  @default(ACTIVE)
  activityType                   ProcessFlowActivityType             @default(PRODUCTION) @map("activity_type")
  qualityFormVersionId           String?                             @map("quality_form_version_id")
  qualityExecutionMode           QualityExecutionMode?               @map("quality_execution_mode")
  associatedProductionActivityId String?                             @map("associated_production_activity_id")
  qualityAvailabilityPolicy      QualityAvailabilityPolicy?          @map("quality_availability_policy")
  progressThresholdPercent       Decimal?                            @map("progress_threshold_percent") @db.Decimal(5, 2)
  gateSatisfactionRequirement    QualityGateSatisfactionRequirement? @map("gate_satisfaction_requirement")
  executionMultiplicity          QualityExecutionMultiplicity?       @map("execution_multiplicity")
  coverageTarget                 QualityCoverageTarget?              @map("coverage_target")
  createdAt                      DateTime                            @default(now()) @map("created_at")
  updatedAt                      DateTime                            @updatedAt @map("updated_at")

  processFlowVersion           ProcessFlowVersion         @relation(fields: [processFlowVersionId], references: [id], onDelete: Cascade)
  qualityFormVersion           QualityFormVersion?        @relation(fields: [qualityFormVersionId], references: [id], onDelete: Restrict, map: "process_flow_activity_quality_form_version_fkey")
  associatedProductionActivity ProcessFlowVersionStage?   @relation("ProcessFlowActivityAssociation", fields: [associatedProductionActivityId], references: [id], onDelete: Restrict, map: "process_flow_activity_associated_production_fkey")
  associatedQualityActivities  ProcessFlowVersionStage[]  @relation("ProcessFlowActivityAssociation")
  jobOrderStageStatuses        JobOrderStageStatus[]
  qualityExecutions            QualityActivityExecution[]
  finalQualityBatches          FinalQualityBatch[]

  @@unique([processFlowVersionId, sequence])
  @@index([processFlowVersionId])
  @@index([qualityFormVersionId])
  @@index([associatedProductionActivityId], map: "process_flow_version_stages_associated_production_activity_id_i")
  @@index([activityType])
  @@map("process_flow_version_stages")
}

// Quality Forms define WHAT is collected. They deliberately contain no
// Process Flow timing, production-step association, or availability trigger.
model QualityForm {
  id          String            @id
  code        String            @unique
  name        String
  description String?
  status      QualityFormStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  versions QualityFormVersion[]

  @@index([status])
  @@map("quality_forms")
}

model QualityFormVersion {
  id             String                    @id
  qualityFormId  String                    @map("quality_form_id")
  versionNumber  Int                       @map("version_number")
  activityType   QualityFormActivityType   @map("activity_type")
  executionScope QualityFormExecutionScope @map("execution_scope")
  status         QualityFormVersionStatus  @default(DRAFT)
  publishedAt    DateTime?                 @map("published_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  qualityForm           QualityForm                @relation(fields: [qualityFormId], references: [id], onDelete: Cascade)
  sections              QualityFormSection[]
  processFlowActivities ProcessFlowVersionStage[]
  qualityExecutions     QualityActivityExecution[]

  @@unique([qualityFormId, versionNumber])
  @@index([qualityFormId])
  @@index([status])
  @@index([activityType])
  @@index([executionScope])
  @@map("quality_form_versions")
}

model QualityFormSection {
  id                   String   @id
  qualityFormVersionId String   @map("quality_form_version_id")
  sequence             Int
  title                String
  description          String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  version    QualityFormVersion     @relation(fields: [qualityFormVersionId], references: [id], onDelete: Cascade)
  components QualityFormComponent[]

  @@unique([qualityFormVersionId, sequence])
  @@index([qualityFormVersionId])
  @@map("quality_form_sections")
}

model QualityFormComponent {
  id                   String                   @id
  qualityFormSectionId String                   @map("quality_form_section_id")
  sequence             Int
  type                 QualityFormComponentType
  title                String
  description          String?
  config               Json
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  section QualityFormSection @relation(fields: [qualityFormSectionId], references: [id], onDelete: Cascade)

  @@unique([qualityFormSectionId, sequence])
  @@index([qualityFormSectionId])
  @@index([type])
  @@map("quality_form_components")
}

// ---------------------------------------------------------------------------
// Distributor Purchase Orders
// ---------------------------------------------------------------------------

model DistributorPurchaseOrder {
  id                   String              @id
  poNumber             String              @unique @map("po_number")
  distributorId        String              @map("distributor_id")
  merchandiserId       String?             @map("merchandiser_id")
  poDate               DateTime            @map("po_date") @db.Date
  requiredDeliveryDate DateTime?           @map("required_delivery_date") @db.Date
  purchaseMode         PurchaseMode        @map("purchase_mode")
  status               PurchaseOrderStatus @default(DRAFT)
  remarks              String?
  createdBy            String              @map("created_by")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  version              Int                 @default(1)
  // Financial Year of this PO's own poDate — never inherited by downstream
  // documents. poSerial is scoped to (financialYearId) via the composite
  // unique below; the actual next-serial source of truth is DocumentSequence.
  financialYearId      String              @map("financial_year_id")
  poSerial             Int                 @map("po_serial")

  distributor   Distributor                    @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  merchandiser  User?                          @relation("POMerchandiser", fields: [merchandiserId], references: [id], onDelete: SetNull)
  creator       User                           @relation("POCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  financialYear FinancialYear                  @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  lines         DistributorPurchaseOrderLine[]
  jobOrders     JobOrder[]

  @@unique([financialYearId, poSerial])
  @@index([distributorId])
  @@index([status])
  @@index([poDate])
  @@map("distributor_purchase_orders")
}

model DistributorPurchaseOrderLine {
  id              String                  @id
  purchaseOrderId String                  @map("purchase_order_id")
  styleId         String                  @map("style_id")
  lineStatus      PurchaseOrderLineStatus @default(ACTIVE) @map("line_status")
  remarks         String?
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  purchaseOrder   DistributorPurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  style           Style                              @relation(fields: [styleId], references: [id], onDelete: Restrict)
  sizes           DistributorPurchaseOrderLineSize[]
  jobOrderLines   JobOrderLine[]
  seasonSnapshots PurchaseOrderLineSeasonSnapshot[]

  @@unique([purchaseOrderId, styleId])
  @@index([purchaseOrderId])
  @@index([styleId])
  @@map("distributor_purchase_order_lines")
}

model PurchaseOrderLineSeasonSnapshot {
  id                  String   @id
  purchaseOrderLineId String   @map("purchase_order_line_id")
  seasonId            String?  @map("season_id")
  code                String
  name                String
  financialYear       String   @map("financial_year")
  displayName         String   @map("display_name")
  createdAt           DateTime @default(now()) @map("created_at")

  purchaseOrderLine DistributorPurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderLineId, seasonId])
  @@index([seasonId])
  @@map("purchase_order_line_season_snapshots")
}

model DistributorPurchaseOrderLineSize {
  id                  String   @id
  purchaseOrderLineId String   @map("purchase_order_line_id")
  sizeId              String   @map("size_id")
  orderedQuantity     Int      @map("ordered_quantity")
  jobOrderedQuantity  Int      @default(0) @map("job_ordered_quantity")
  qaPassedQuantity    Int      @default(0) @map("qa_passed_quantity")
  saleOrderedQuantity Int      @default(0) @map("sale_ordered_quantity")
  dispatchedQuantity  Int      @default(0) @map("dispatched_quantity")
  deliveredQuantity   Int      @default(0) @map("delivered_quantity")
  actualSoldQuantity  Int      @default(0) @map("actual_sold_quantity")
  returnedQuantity    Int      @default(0) @map("returned_quantity")
  reassignedQuantity  Int      @default(0) @map("reassigned_quantity")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  purchaseOrderLine DistributorPurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  size              Size                         @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  jobOrderLineSizes JobOrderLineSize[]
  qaReleaseLines    QaReleaseLine[]
  saleOrderLines    SaleOrderLine[]

  @@unique([purchaseOrderLineId, sizeId])
  @@index([purchaseOrderLineId])
  @@index([sizeId])
  @@map("distributor_purchase_order_line_sizes")
}

// ---------------------------------------------------------------------------
// Job Orders
// ---------------------------------------------------------------------------

model JobOrder {
  id                        String                    @id
  jobOrderNumber            String                    @unique @map("job_order_number")
  purchaseOrderId           String                    @map("purchase_order_id")
  factoryId                 String                    @map("factory_id")
  processFlowVersionId      String                    @map("process_flow_version_id")
  unitPrice                 Decimal                   @map("unit_price") @db.Decimal(12, 2)
  disclaimerText            String?                   @map("disclaimer_text")
  disclaimerRevision        Int                       @default(0) @map("disclaimer_revision")
  status                    JobOrderStatus            @default(DRAFT)
  factoryConfirmationStatus FactoryConfirmationStatus @default(PENDING) @map("factory_confirmation_status")
  confirmedBy               String?                   @map("confirmed_by")
  confirmedAt               DateTime?                 @map("confirmed_at")
  productionStartedAt       DateTime?                 @map("production_started_at")
  productionCompletedAt     DateTime?                 @map("production_completed_at")
  preparedQuantityTotal     Int                       @default(0) @map("prepared_quantity_total")
  createdBy                 String                    @map("created_by")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  version                   Int                       @default(1)
  // JobOrder has no separate business/document date field — its effective
  // date for Financial Year purposes is this same createdAt, never the
  // parent Purchase Order's Financial Year.
  financialYearId           String                    @map("financial_year_id")
  jobOrderSerial            Int                       @map("job_order_serial")

  purchaseOrder       DistributorPurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  factory             Factory                     @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  processFlowVersion  ProcessFlowVersion          @relation(fields: [processFlowVersionId], references: [id], onDelete: Restrict)
  confirmer           User?                       @relation("JobOrderConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)
  creator             User                        @relation("JobOrderCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  financialYear       FinancialYear               @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  lines               JobOrderLine[]
  stageStatuses       JobOrderStageStatus[]
  idempotencyRecords  JobOrderIdempotencyRecord[]
  qaInspections       QaInspectionSession[]
  qaReworkTasks       QaReworkTask[]
  acknowledgements    JobOrderAcknowledgement[]
  seasonSnapshots     JobOrderSeasonSnapshot[]
  qualityExecutions   QualityActivityExecution[]
  finalQualityBatches FinalQualityBatch[]
  qaReleases          QaRelease[]

  @@unique([financialYearId, jobOrderSerial])
  @@index([purchaseOrderId])
  @@index([factoryId])
  @@index([processFlowVersionId])
  @@index([status])
  @@index([factoryConfirmationStatus])
  @@map("job_orders")
}

// Start eligibility applies only at creation. A valid draft remains editable
// and finalizable after its associated Production activity changes state.
model QualityActivityExecution {
  id                       String                         @id
  jobOrderId               String                         @map("job_order_id")
  processFlowActivityId    String                         @map("process_flow_activity_id")
  qualityFormVersionId     String                         @map("quality_form_version_id")
  attemptNumber            Int                            @default(1) @map("attempt_number")
  batchNumber              Int                            @default(1) @map("batch_number")
  inspectedQuantity        Int?                           @map("inspected_quantity")
  sampleJobOrderLineSizeId String?                        @map("sample_job_order_line_size_id")
  sampleQuantity           Int?                           @map("sample_quantity")
  finalQualityBatchId      String?                        @map("final_quality_batch_id")
  status                   QualityActivityExecutionStatus @default(DRAFT)
  startedById              String                         @map("started_by_id")
  startedAt                DateTime                       @default(now()) @map("started_at")
  finalizedById            String?                        @map("finalized_by_id")
  finalizedAt              DateTime?                      @map("finalized_at")
  outcomeComponentId       String?                        @map("outcome_component_id")
  outcome                  QualityInspectionOutcome?
  outcomeRemarks           String?                        @map("outcome_remarks")
  version                  Int                            @default(1)
  createdAt                DateTime                       @default(now()) @map("created_at")
  updatedAt                DateTime                       @updatedAt @map("updated_at")

  jobOrder               JobOrder                   @relation(fields: [jobOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "quality_activity_executions_job_order_id_fkey")
  processFlowActivity    ProcessFlowVersionStage    @relation(fields: [processFlowActivityId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "quality_activity_executions_process_flow_activity_id_fkey")
  qualityFormVersion     QualityFormVersion         @relation(fields: [qualityFormVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "quality_activity_executions_quality_form_version_id_fkey")
  startedBy              User                       @relation("QualityExecutionStarter", fields: [startedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "quality_activity_executions_started_by_id_fkey")
  finalizedBy            User?                      @relation("QualityExecutionFinalizer", fields: [finalizedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "quality_activity_executions_finalized_by_id_fkey")
  checklistResponses     QualityChecklistResponse[]
  aqlResults             QualityAqlResult[]
  defects                QualityDefect[]
  correctiveActions      QualityCorrectiveAction[]
  testResults            QualityTestResult[]
  quantities             QualityQuantityResponse[]
  comments               QualityCommentResponse[]
  signoffs               QualitySignoff[]
  attachments            QualityAttachment[]
  fieldResponses         QualityFieldResponse[]
  attendeeResponses      QualityAttendeeResponse[]
  actionResponses        QualityActionResponse[]
  ppSampleSession        QaInspectionSession?
  sampleJobOrderLineSize JobOrderLineSize?          @relation("QualityExecutionSampleSize", fields: [sampleJobOrderLineSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "quality_activity_executions_sample_size_id_fkey")
  finalQualityBatch      FinalQualityBatch?         @relation(fields: [finalQualityBatchId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "quality_activity_executions_final_quality_batch_id_fkey")
  qaRelease              QaRelease?
  spawnedRework          FinalQualityBatchRework?

  @@unique([jobOrderId, processFlowActivityId, attemptNumber, batchNumber], map: "quality_execution_attempt_batch_key")
  @@index([jobOrderId, processFlowActivityId, status], map: "quality_execution_status_idx")
  @@index([qualityFormVersionId], map: "quality_execution_form_idx")
  @@index([finalQualityBatchId, attemptNumber], map: "quality_execution_final_batch_attempt_idx")
  @@map("quality_activity_executions")
}

model FinalQualityBatch {
  id                    String                       @id
  jobOrderId            String                       @map("job_order_id")
  processFlowActivityId String                       @map("process_flow_activity_id")
  batchNumber           Int                          @map("batch_number")
  physicalQuantity      Int                          @map("physical_quantity")
  disposition           FinalQualityBatchDisposition @default(DRAFT)
  createdById           String                       @map("created_by_id")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  terminalById          String?                      @map("terminal_by_id")
  terminalAt            DateTime?                    @map("terminal_at")
  terminalReason        String?                      @map("terminal_reason")

  jobOrder            JobOrder                      @relation(fields: [jobOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  processFlowActivity ProcessFlowVersionStage       @relation(fields: [processFlowActivityId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy           User                          @relation("FinalQualityBatchCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  terminalBy          User?                         @relation("FinalQualityBatchTerminalActor", fields: [terminalById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocations         FinalQualityBatchAllocation[]
  executions          QualityActivityExecution[]
  release             QaRelease?
  reworks             FinalQualityBatchRework[]

  @@unique([jobOrderId, processFlowActivityId, batchNumber], map: "final_quality_batch_number_key")
  @@index([jobOrderId, processFlowActivityId, disposition], map: "final_quality_batch_state_idx")
  @@map("final_quality_batches")
}

// One Factory corrective-action cycle spawned by a Final FAIL. Append-only:
// a repeat FAIL creates the next cycle rather than mutating a prior one, so
// the full rework history for a physical batch is always reconstructable.
model FinalQualityBatchRework {
  id                       String                        @id
  finalQualityBatchId      String                        @map("final_quality_batch_id")
  failedQualityExecutionId String                        @unique @map("failed_quality_execution_id")
  cycleNumber              Int                           @map("cycle_number")
  status                   FinalQualityBatchReworkStatus @default(REQUIRED)
  acknowledgedById         String?                       @map("acknowledged_by_id")
  acknowledgedAt           DateTime?                     @map("acknowledged_at")
  startedById              String?                       @map("started_by_id")
  startedAt                DateTime?                     @map("started_at")
  completedById            String?                       @map("completed_by_id")
  completedAt              DateTime?                     @map("completed_at")
  notes                    String?
  version                  Int                           @default(1)
  createdAt                DateTime                      @default(now()) @map("created_at")
  updatedAt                DateTime                      @updatedAt @map("updated_at")

  finalQualityBatch      FinalQualityBatch        @relation(fields: [finalQualityBatchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  failedQualityExecution QualityActivityExecution @relation(fields: [failedQualityExecutionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  acknowledgedBy         User?                    @relation("FinalBatchReworkAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  startedBy              User?                    @relation("FinalBatchReworkStartedBy", fields: [startedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  completedBy            User?                    @relation("FinalBatchReworkCompletedBy", fields: [completedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([finalQualityBatchId, cycleNumber], map: "final_quality_batch_rework_cycle_key")
  @@index([finalQualityBatchId, status], map: "final_quality_batch_rework_state_idx")
  @@map("final_quality_batch_reworks")
}

model FinalQualityBatchAllocation {
  id                  String   @id
  finalQualityBatchId String   @map("final_quality_batch_id")
  jobOrderLineSizeId  String   @map("job_order_line_size_id")
  quantity            Int
  createdAt           DateTime @default(now()) @map("created_at")

  finalQualityBatch FinalQualityBatch @relation(fields: [finalQualityBatchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobOrderLineSize  JobOrderLineSize  @relation(fields: [jobOrderLineSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([finalQualityBatchId, jobOrderLineSizeId], map: "final_quality_batch_allocation_size_key")
  @@index([jobOrderLineSizeId], map: "final_quality_batch_allocation_size_idx")
  @@map("final_quality_batch_allocations")
}

model QaRelease {
  id                       String   @id
  jobOrderId               String   @map("job_order_id")
  sourceQualityExecutionId String   @unique(map: "qa_release_source_execution_key") @map("source_quality_execution_id")
  finalQualityBatchId      String   @unique(map: "qa_release_final_batch_key") @map("final_quality_batch_id")
  releasedById             String   @map("released_by_id")
  releasedAt               DateTime @default(now()) @map("released_at")

  jobOrder               JobOrder                 @relation(fields: [jobOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceQualityExecution QualityActivityExecution @relation(fields: [sourceQualityExecutionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  finalQualityBatch      FinalQualityBatch        @relation(fields: [finalQualityBatchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  releasedBy             User                     @relation("QaReleaseActor", fields: [releasedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines                  QaReleaseLine[]

  @@index([jobOrderId, releasedAt], map: "qa_release_job_order_idx")
  @@map("qa_releases")
}

model QaReleaseLine {
  id                      String @id
  qaReleaseId             String @map("qa_release_id")
  jobOrderLineSizeId      String @map("job_order_line_size_id")
  purchaseOrderLineSizeId String @map("purchase_order_line_size_id")
  quantity                Int

  release               QaRelease                        @relation(fields: [qaReleaseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  jobOrderLineSize      JobOrderLineSize                 @relation(fields: [jobOrderLineSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchaseOrderLineSize DistributorPurchaseOrderLineSize @relation(fields: [purchaseOrderLineSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocations           StockAllocation[]

  @@unique([qaReleaseId, jobOrderLineSizeId], map: "qa_release_line_size_key")
  @@index([purchaseOrderLineSizeId], map: "qa_release_line_po_size_idx")
  @@map("qa_release_lines")
}

// ---------------------------------------------------------------------------
// Sale Orders — a distributor's request against their own QA-released stock,
// reviewed/approved by a merchandiser. QaRelease/QaReleaseLine above remain
// the immutable authoritative record of released stock; this feature never
// mutates them. Inventory reservation/reassignment is expressed entirely
// through StockAllocation rows layered on top.
// ---------------------------------------------------------------------------

enum SaleOrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  FULFILLED
}

enum StockAllocationStatus {
  ACTIVE
  RELEASED
}

// DISTRIBUTOR_REQUEST: created at submit time from the requesting
// distributor's own released stock. MERCHANDISER_ADJUSTMENT: merchandiser
// sources an increase from the same distributor's other Job Orders/POs.
// MERCHANDISER_REASSIGNMENT: merchandiser sources an increase from a
// different distributor's released stock (requires `reason`).
enum StockAllocationSource {
  DISTRIBUTOR_REQUEST
  MERCHANDISER_ADJUSTMENT
  MERCHANDISER_REASSIGNMENT
}

model SaleOrder {
  id                   String          @id
  saleOrderNumber      String          @unique @map("sale_order_number")
  distributorId        String          @map("distributor_id")
  createdBy            String          @map("created_by")
  soDate               DateTime        @map("so_date") @db.Date
  status               SaleOrderStatus @default(DRAFT)
  remarks              String?
  submittedAt          DateTime?       @map("submitted_at")
  reviewedById         String?         @map("reviewed_by_id")
  reviewedAt           DateTime?       @map("reviewed_at")
  decisionReason       String?         @map("decision_reason")
  // Set only on the APPROVED -> FULFILLED transition (fulfillSaleOrder) — the
  // minimal "stock was actually handed to the distributor" closing step.
  // fulfillmentReference is a free-text business reference (e.g. a delivery
  // challan/POD number) captured outside this system for now; no
  // Dispatch/Shipment model exists yet, this is deliberately not one.
  fulfilledById        String?         @map("fulfilled_by_id")
  fulfilledAt          DateTime?       @map("fulfilled_at")
  fulfillmentReference String?         @map("fulfillment_reference")
  // The Sale Order's own Financial Year, derived from its own soDate — never
  // inherited from the referenced Purchase Order(s), matching the
  // DistributorPurchaseOrder/JobOrder convention.
  financialYearId      String          @map("financial_year_id")
  soSerial             Int             @map("so_serial")
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  distributor        Distributor                  @relation(fields: [distributorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator            User                         @relation("SaleOrderCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewedBy         User?                        @relation("SaleOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  fulfilledBy        User?                        @relation("SaleOrderFulfiller", fields: [fulfilledById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  financialYear      FinancialYear                @relation(fields: [financialYearId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines              SaleOrderLine[]
  idempotencyRecords SaleOrderIdempotencyRecord[]
  factoryDispatches  FactoryDispatch[]
  ervePackingLists   ErvePackingList[]
  erveDispatches     ErveDispatch[]

  @@unique([financialYearId, soSerial])
  @@index([distributorId])
  @@index([status])
  @@map("sale_orders")
}

model SaleOrderLine {
  id                      String   @id
  saleOrderId             String   @map("sale_order_id")
  // The distributor's own PO line/size — the same granularity
  // qaPassedQuantity is already exposed at. Resolution to specific
  // QaReleaseLine(s) happens at submit/approve time via StockAllocation, not
  // at line-creation time.
  purchaseOrderLineSizeId String   @map("purchase_order_line_size_id")
  // Immutable once the Sale Order is submitted — enforced in the service
  // layer, never overwritten by a merchandiser's decision.
  requestedQuantity       Int      @map("requested_quantity")
  approvedQuantity        Int?     @map("approved_quantity")
  remarks                 String?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  saleOrder                   SaleOrder                        @relation(fields: [saleOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseOrderLineSize       DistributorPurchaseOrderLineSize @relation(fields: [purchaseOrderLineSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocations                 StockAllocation[]
  factoryDispatchLines        FactoryDispatchLine[]
  invoiceHandoffs             InvoiceHandoff[]
  distributorSalesReportLines DistributorSalesReportLine[]
  erveDispatchDeliveryLines   ErveDispatchDeliveryLine[]
  distributorReturnLines      DistributorReturnLine[]
  returnedStockLots           ReturnedStockLot[]

  @@unique([saleOrderId, purchaseOrderLineSizeId], map: "sale_order_line_size_key")
  @@index([saleOrderId])
  @@index([purchaseOrderLineSizeId])
  @@map("sale_order_lines")
}

// One ledger row per (Sale Order line, source QA release line) — makes
// "available quantity" for a QaReleaseLine a trivial GROUP BY, and makes the
// invariant "sum(active allocations) == approvedQuantity" straightforward to
// check. `quantity` is mutated in place as approvals reduce/increase it
// (matching this codebase's convention of mutating operational counters and
// keeping full history in AuditLog) — this does NOT apply to QaReleaseLine,
// which stays immutable.
model StockAllocation {
  id               String                @id
  saleOrderLineId  String                @map("sale_order_line_id")
  qaReleaseLineId  String                @map("qa_release_line_id")
  quantity         Int
  status           StockAllocationStatus @default(ACTIVE)
  allocationSource StockAllocationSource @map("allocation_source")
  // Required (service-enforced) when allocationSource = MERCHANDISER_REASSIGNMENT.
  reason           String?
  allocatedById    String                @map("allocated_by_id")
  releasedById     String?               @map("released_by_id")
  releasedAt       DateTime?             @map("released_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  saleOrderLine        SaleOrderLine         @relation(fields: [saleOrderLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  qaReleaseLine        QaReleaseLine         @relation(fields: [qaReleaseLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocatedBy          User                  @relation("StockAllocationAllocator", fields: [allocatedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  releasedBy           User?                 @relation("StockAllocationReleaser", fields: [releasedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  factoryDispatchLines FactoryDispatchLine[]

  @@unique([saleOrderLineId, qaReleaseLineId], map: "stock_allocation_line_release_key")
  @@index([qaReleaseLineId, status], map: "stock_allocation_release_status_idx")
  @@index([saleOrderLineId, status])
  @@map("stock_allocations")
}

// ---------------------------------------------------------------------------
// Fulfillment: Factory Packing -> Erve India Consolidation -> Distributor
// Dispatch. Sits entirely downstream of StockAllocation, which this section
// never mutates or releases (see FactoryDispatchLine.stockAllocationId) — the
// authoritative allocation ledger stays exactly as approveSaleOrder left it,
// through packing, consolidation and dispatch. SaleOrder.status remains
// APPROVED through every stage here; only the final ErveDispatch transaction
// that exhausts every approved line's cumulative dispatched quantity flips it
// to FULFILLED (see erve-dispatch.service.ts recordErveDispatch). Invoice/
// Tally integration is explicitly out of scope and sits downstream of this.
// ---------------------------------------------------------------------------

enum FactoryDispatchStatus {
  DRAFT
  READY_FOR_ERVE
}

// One batch of approved goods a single Factory prepares for handoff into
// Erve India's consolidation flow. factoryId is resolved once at creation
// from the (single, authoritative) Factory that owns every line's source
// StockAllocation — see factory-source-resolution.ts — never inferred from
// the Sale Order itself, which may be sourced from multiple Factories.
model FactoryDispatch {
  id                    String                @id
  factoryDispatchNumber String                @unique @map("factory_dispatch_number")
  factoryId             String                @map("factory_id")
  saleOrderId           String                @map("sale_order_id")
  status                FactoryDispatchStatus @default(DRAFT)
  preparedById          String                @map("prepared_by_id")
  preparedAt            DateTime              @default(now()) @map("prepared_at")
  finalizedById         String?               @map("finalized_by_id")
  finalizedAt           DateTime?             @map("finalized_at")
  version               Int                   @default(1)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  financialYearId       String                @map("financial_year_id")
  factoryDispatchSerial Int                   @map("factory_dispatch_serial")

  factory           Factory                @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  saleOrder         SaleOrder              @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)
  preparedBy        User                   @relation("FactoryDispatchPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  finalizedBy       User?                  @relation("FactoryDispatchFinalizer", fields: [finalizedById], references: [id], onDelete: Restrict)
  financialYear     FinancialYear          @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  lines             FactoryDispatchLine[]
  cartons           FactoryPackingCarton[]
  ervePackingSource ErvePackingListSource?

  @@unique([financialYearId, factoryDispatchSerial])
  @@index([factoryId, status])
  @@index([saleOrderId])
  @@map("factory_dispatches")
}

// One line = one packed quantity backed by exactly one authoritative
// StockAllocation row — the proof that this Factory really owns these
// physical units (see the module doc comment above and
// factory-source-resolution.ts). Multiple lines against the SAME allocation
// across DIFFERENT FactoryDispatch batches are expected (successive partial
// packing cycles); the unique constraint below only prevents a duplicate
// line within one batch.
model FactoryDispatchLine {
  id                String   @id
  factoryDispatchId String   @map("factory_dispatch_id")
  saleOrderLineId   String   @map("sale_order_line_id")
  stockAllocationId String   @map("stock_allocation_id")
  packedQuantity    Int      @map("packed_quantity")
  createdAt         DateTime @default(now()) @map("created_at")

  factoryDispatch FactoryDispatch            @relation(fields: [factoryDispatchId], references: [id], onDelete: Cascade)
  saleOrderLine   SaleOrderLine              @relation(fields: [saleOrderLineId], references: [id], onDelete: Restrict)
  stockAllocation StockAllocation            @relation(fields: [stockAllocationId], references: [id], onDelete: Restrict)
  cartonLines     FactoryPackingCartonLine[]

  @@unique([factoryDispatchId, stockAllocationId], map: "factory_dispatch_line_allocation_key")
  @@index([stockAllocationId])
  @@index([saleOrderLineId])
  @@map("factory_dispatch_lines")
}

// Minimal carton/package record per the original scope (carton number,
// package details, weight only) — deliberately no barcode/dimensions/rates/
// warehouse bin.
model FactoryPackingCarton {
  id                String   @id
  factoryDispatchId String   @map("factory_dispatch_id")
  cartonNumber      String   @map("carton_number")
  packageDetails    String?  @map("package_details")
  weight            Decimal? @db.Decimal(10, 3)
  createdAt         DateTime @default(now()) @map("created_at")

  factoryDispatch FactoryDispatch            @relation(fields: [factoryDispatchId], references: [id], onDelete: Cascade)
  lines           FactoryPackingCartonLine[]

  @@unique([factoryDispatchId, cartonNumber])
  @@map("factory_packing_cartons")
}

// A carton's contents, by quantity, against one packed FactoryDispatchLine.
// SUM(quantity) per factoryDispatchLineId must never exceed that line's
// packedQuantity (service-enforced) — this is what prevents the same packed
// units from being placed into multiple cartons.
model FactoryPackingCartonLine {
  id                    String   @id
  cartonId              String   @map("carton_id")
  factoryDispatchLineId String   @map("factory_dispatch_line_id")
  quantity              Int
  createdAt             DateTime @default(now()) @map("created_at")

  carton              FactoryPackingCarton @relation(fields: [cartonId], references: [id], onDelete: Cascade)
  factoryDispatchLine FactoryDispatchLine  @relation(fields: [factoryDispatchLineId], references: [id], onDelete: Restrict)

  @@unique([cartonId, factoryDispatchLineId])
  @@index([factoryDispatchLineId])
  @@map("factory_packing_carton_lines")
}

enum ErvePackingListStatus {
  OPEN
  DISPATCHED
}

// Erve India's consolidation of one or more finalized (READY_FOR_ERVE)
// Factory Dispatch batches, scoped to a single Sale Order for MVP (see
// module doc). Line-level contents are deliberately NOT duplicated here —
// they are derived by joining ErvePackingListSource -> FactoryDispatch ->
// FactoryDispatchLine, so there is exactly one packed-quantity ledger.
model ErvePackingList {
  id                    String                @id
  ervePackingListNumber String                @unique @map("erve_packing_list_number")
  saleOrderId           String                @map("sale_order_id")
  status                ErvePackingListStatus @default(OPEN)
  createdById           String                @map("created_by_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  financialYearId       String                @map("financial_year_id")
  ervePackingListSerial Int                   @map("erve_packing_list_serial")

  saleOrder     SaleOrder               @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)
  createdBy     User                    @relation("ErvePackingListCreator", fields: [createdById], references: [id], onDelete: Restrict)
  financialYear FinancialYear           @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  sources       ErvePackingListSource[]
  dispatch      ErveDispatch?

  @@unique([financialYearId, ervePackingListSerial])
  @@index([saleOrderId, status])
  @@map("erve_packing_lists")
}

// Join of exactly which finalized Factory Dispatch batches were consolidated
// into this Erve Packing List. factoryDispatchId is unique — a Factory
// Dispatch may be consumed into at most one Erve Packing List, ever.
model ErvePackingListSource {
  id                String   @id
  ervePackingListId String   @map("erve_packing_list_id")
  factoryDispatchId String   @unique @map("factory_dispatch_id")
  consolidatedAt    DateTime @default(now()) @map("consolidated_at")

  ervePackingList ErvePackingList @relation(fields: [ervePackingListId], references: [id], onDelete: Restrict)
  factoryDispatch FactoryDispatch @relation(fields: [factoryDispatchId], references: [id], onDelete: Restrict)

  @@index([ervePackingListId])
  @@map("erve_packing_list_sources")
}

enum ErveDispatchStatus {
  DISPATCHED
  DELIVERED
}

// Distinguishes a real merchandising-team delivery confirmation from the
// one-time migration backfill applied to dispatches that predate this field
// (see the backfill migration) — lets an auditor tell "confirmed 100
// received" from "we don't actually know, we assumed full receipt when this
// column was introduced." confirmErveDispatchDelivery always writes
// USER_CONFIRMED; the backfill always writes LEGACY_ASSUMED_FULL_RECEIPT.
enum DeliveryConfirmationSource {
  USER_CONFIRMED
  LEGACY_ASSUMED_FULL_RECEIPT
}

// Actual physical outward movement to the Distributor. 1:1 with
// ErvePackingList (ervePackingListId unique) — a packing list is dispatched
// exactly once. Deliberately no DRAFT stage (see module doc): the Erve
// Packing List already represents "prepared", so creating this row IS the
// single authoritative Record Dispatch action. lrNumber/transporter/
// vehicleNumber may be filled in later via the LR-update fallback action
// (lrUpdatedById/At) since the LR is often issued by the transporter only
// after physical pickup.
model ErveDispatch {
  id                         String                      @id
  erveDispatchNumber         String                      @unique @map("erve_dispatch_number")
  ervePackingListId          String                      @unique @map("erve_packing_list_id")
  saleOrderId                String                      @map("sale_order_id")
  distributorId              String                      @map("distributor_id")
  status                     ErveDispatchStatus          @default(DISPATCHED)
  dispatchDate               DateTime                    @map("dispatch_date") @db.Date
  transporter                String?
  vehicleNumber              String?                     @map("vehicle_number")
  lrNumber                   String?                     @map("lr_number")
  remarks                    String?
  dispatchedById             String                      @map("dispatched_by_id")
  dispatchedAt               DateTime                    @default(now()) @map("dispatched_at")
  lrUpdatedById              String?                     @map("lr_updated_by_id")
  lrUpdatedAt                DateTime?                   @map("lr_updated_at")
  // Delivery confirmation — the "received by distributor" fact that
  // DistributorSalesReport and DistributorReturn key off, distinct from the
  // dispatchedQuantity historical outward-movement fact above (see
  // ErveDispatchDeliveryLine doc). deliveredById/deliveredAt are left null on
  // legacy-backfilled rows — do not treat a null pair here as a bug, it means
  // "assumed for compatibility, not actually confirmed by anyone."
  deliveredById              String?                     @map("delivered_by_id")
  deliveredAt                DateTime?                   @map("delivered_at")
  deliveryRemarks            String?                     @map("delivery_remarks")
  deliveryConfirmationSource DeliveryConfirmationSource? @map("delivery_confirmation_source")
  version                    Int                         @default(1)
  createdAt                  DateTime                    @default(now()) @map("created_at")
  financialYearId            String                      @map("financial_year_id")
  erveDispatchSerial         Int                         @map("erve_dispatch_serial")

  ervePackingList             ErvePackingList              @relation(fields: [ervePackingListId], references: [id], onDelete: Restrict)
  saleOrder                   SaleOrder                    @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)
  distributor                 Distributor                  @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  dispatchedBy                User                         @relation("ErveDispatchDispatcher", fields: [dispatchedById], references: [id], onDelete: Restrict)
  lrUpdatedBy                 User?                        @relation("ErveDispatchLrUpdater", fields: [lrUpdatedById], references: [id], onDelete: Restrict)
  deliveredBy                 User?                        @relation("ErveDispatchDeliveryConfirmer", fields: [deliveredById], references: [id], onDelete: Restrict)
  financialYear               FinancialYear                @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  invoiceHandoffs             InvoiceHandoff[]
  distributorSalesReportLines DistributorSalesReportLine[]
  deliveryLines               ErveDispatchDeliveryLine[]
  distributorReturnLines      DistributorReturnLine[]

  @@unique([financialYearId, erveDispatchSerial])
  @@index([saleOrderId])
  @@index([distributorId])
  @@map("erve_dispatches")
}

// One row per SaleOrderLine actually confirmed received for this Dispatch,
// created once by the single DISPATCHED -> DELIVERED transition (not
// append-only/repeatable like DistributorSalesReportLine — see
// confirmErveDispatchDelivery). receivedQuantity may be less than the
// dispatched quantity for that line to capture a shortage (shortage =
// dispatched - received, derived on read, never stored) — see
// ErveDispatch.deliveryRemarks for the accompanying note, required whenever
// any line is short. This is the new authoritative "received by distributor"
// fact that DistributorSalesReport and DistributorReturn key off, replacing
// dispatchedQuantity as their ceiling basis.
model ErveDispatchDeliveryLine {
  id               String   @id
  erveDispatchId   String   @map("erve_dispatch_id")
  saleOrderLineId  String   @map("sale_order_line_id")
  receivedQuantity Int      @map("received_quantity")
  createdAt        DateTime @default(now()) @map("created_at")

  erveDispatch  ErveDispatch  @relation(fields: [erveDispatchId], references: [id], onDelete: Restrict)
  saleOrderLine SaleOrderLine @relation(fields: [saleOrderLineId], references: [id], onDelete: Restrict)

  @@unique([erveDispatchId, saleOrderLineId])
  @@index([saleOrderLineId])
  @@map("erve_dispatch_delivery_lines")
}

// ---------------------------------------------------------------------------
// Physical Dispatch -> Invoice/Tally reference handoff ("Dispatch Sale").
// Erve India remains the operational tracker; Tally remains the accounting
// system of record and the sole generator of the actual sales invoice/
// e-invoice/e-way bill.
//
// Financial granularity is deliberately the SALE ORDER LINE within one
// ErveDispatch, never the whole Dispatch or Sale Order — a Sale Order (and
// therefore one ErveDispatch consolidating it) can span multiple Purchase
// Orders with DIFFERENT PurchaseMode values (nothing in this codebase
// restricts a Sale Order to one PO — see sale-orders.service.ts submit,
// which explicitly locks/validates a SET of purchaseOrderIds). So a single
// physical Dispatch can legitimately contain both OUTRIGHT and SALE_RETURN
// quantity.
//
// EVERY physically dispatched quantity — both PurchaseMode values — gets
// exactly one InvoiceHandoff row per (erveDispatchId, saleOrderLineId), the
// moment ErveDispatch is recorded (see erve-dispatch.service.ts
// recordErveDispatch). This represents "Dispatch Sale": the invoice/Tally
// linkage tied to the physical outward movement, which for GST/accounting
// purposes happens for consignment (SALE_RETURN) stock too, not just
// OUTRIGHT. PurchaseMode is NOT stored here — it is resolved on read through
// the same commercial FK chain (SaleOrderLine -> purchaseOrderLineSize ->
// purchaseOrderLine -> DistributorPurchaseOrder.purchaseMode) whenever a
// mode breakdown is useful for reporting.
//
// "Dispatch Sale" is deliberately NOT the same fact as "Actual Sale": for
// SALE_RETURN, a Distributor's later reported sell-through
// (DistributorSalesReportLine, see below) is a separate commercial-
// settlement/royalty-reporting fact and never creates a second
// InvoiceHandoff — the physical-movement invoice already exists from
// Dispatch. Do not reintroduce a report-sourced handoff branch here.
//
// PurchaseMode itself is never snapshotted: DistributorPurchaseOrder.
// purchaseMode is only editable in DRAFT (updatePurchaseOrderDraft), and no
// Sale Order line can exist against a PO before it has left DRAFT for good
// (job-ordered POs never return to DRAFT) — so by the time a line is
// financially relevant, its source PO's mode is already frozen and safe to
// trace through the FK chain instead of duplicating.
//
// No amount/tax/GST fields exist here on purpose: Tally computes and owns
// pricing/tax, this system only stores the resulting reference. Whether one
// Tally invoice may cover multiple handoff rows (dispatch consolidation) is
// an explicitly OPEN business question — tallyInvoiceNumber is therefore NOT
// unique; recording the same number on several handoff rows is allowed. The
// @@unique([erveDispatchId, saleOrderLineId]) below is a FACT-identity
// constraint only (one Dispatch Sale fact per physically dispatched line,
// preventing duplicate auto-creation) — it does not constrain Tally grouping.
// ---------------------------------------------------------------------------

enum InvoiceHandoffStatus {
  PENDING_TALLY
  INVOICED
}

model InvoiceHandoff {
  id              String @id
  erveDispatchId  String @map("erve_dispatch_id")
  saleOrderLineId String @map("sale_order_line_id")

  // The physically dispatched quantity this handoff represents — the summed
  // packed quantity for this (erveDispatchId, saleOrderLineId) pair. Never
  // re-derived from requestedQuantity/approvedQuantity/DistributorSalesReport
  // — the physical Dispatch is the sole authoritative source.
  quantity Int

  status                InvoiceHandoffStatus @default(PENDING_TALLY)
  tallyInvoiceNumber    String?              @map("tally_invoice_number")
  tallyInvoiceDate      DateTime?            @map("tally_invoice_date") @db.Date
  tallyVoucherReference String?              @map("tally_voucher_reference")
  remarks               String?
  recordedById          String?              @map("recorded_by_id")
  recordedAt            DateTime?            @map("recorded_at")
  version               Int                  @default(1)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  erveDispatch  ErveDispatch  @relation(fields: [erveDispatchId], references: [id], onDelete: Restrict)
  saleOrderLine SaleOrderLine @relation(fields: [saleOrderLineId], references: [id], onDelete: Restrict)
  recordedBy    User?         @relation("InvoiceHandoffRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([erveDispatchId, saleOrderLineId])
  @@index([status])
  @@map("invoice_handoffs")
}

// ---------------------------------------------------------------------------
// Distributor-reported ACTUAL SALE of previously-dispatched SALE_RETURN
// stock (BRD 6.7/8.13 "Actual Sales Reported by Distributor"). This is a
// commercial sell-through / royalty-reporting fact, distinct from the
// Dispatch Sale invoice handoff above — recording one here NEVER creates or
// mutates an InvoiceHandoff (that invoice already exists from the physical
// Dispatch). Append-only per report — a Distributor submits repeated partial
// reports over time rather than overwriting a cumulative total, matching
// this codebase's append-only-fact convention (see FinalQualityBatchRework).
// Only quantities against SALE_RETURN-sourced dispatched lines may be
// reported (service-enforced); OUTRIGHT lines never go through this model —
// for OUTRIGHT, physically dispatched quantity IS the commercially sold
// quantity. This intentionally does NOT touch StockAllocation — once
// physically dispatched, stock is no longer part of the central QA/
// allocation availability model; SALE_RETURN consignment position
// (dispatched/actual sold/remaining) is a separate downstream view derived
// by summing FactoryDispatchLine.packedQuantity against
// DistributorSalesReportLine.quantitySold for the same (erveDispatchId,
// saleOrderLineId) pair (see distributor-sales-report.service.ts).
//
// Forward-compatibility note (future RESALE phase, not implemented here):
// a future RESALE of returned stock is also royalty-reportable but must
// never create an InvoiceHandoff either — invoicing and royalty-reporting
// are kept as separate concerns on purpose so that distinction holds later
// without a structural rework. Provenance back to the original ErveDispatch
// line is preserved here precisely so a later Return/Resale model can trace
// through this same (erveDispatchId, saleOrderLineId) pair.
// ---------------------------------------------------------------------------

model DistributorSalesReport {
  id            String   @id
  distributorId String   @map("distributor_id")
  reportDate    DateTime @map("report_date") @db.Date
  remarks       String?
  submittedById String   @map("submitted_by_id")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  createdAt     DateTime @default(now()) @map("created_at")

  distributor Distributor                  @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  submittedBy User                         @relation("DistributorSalesReportSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  lines       DistributorSalesReportLine[]

  @@index([distributorId])
  @@map("distributor_sales_reports")
}

model DistributorSalesReportLine {
  id                       String   @id
  distributorSalesReportId String   @map("distributor_sales_report_id")
  // The specific dispatched SALE_RETURN source line this reported quantity
  // is being sold from — the authoritative cap for cumulative reporting is
  // this line's dispatched quantity, never the Sale Order's requested/
  // approved quantity (see the service's ceiling validation).
  erveDispatchId           String   @map("erve_dispatch_id")
  saleOrderLineId          String   @map("sale_order_line_id")
  quantitySold             Int      @map("quantity_sold")
  createdAt                DateTime @default(now()) @map("created_at")

  report        DistributorSalesReport @relation(fields: [distributorSalesReportId], references: [id], onDelete: Cascade)
  erveDispatch  ErveDispatch           @relation(fields: [erveDispatchId], references: [id], onDelete: Restrict)
  saleOrderLine SaleOrderLine          @relation(fields: [saleOrderLineId], references: [id], onDelete: Restrict)

  @@index([distributorSalesReportId])
  @@index([erveDispatchId, saleOrderLineId])
  @@map("distributor_sales_report_lines")
}

// ---------------------------------------------------------------------------
// Distributor Return — the second half of the SALE_RETURN model: unsold
// stock physically coming back from a Distributor to Erve. Applies only to
// SALE_RETURN-sourced dispatched lines (service-enforced). Deliberately does
// NOT release/mutate the original StockAllocation, QaReleaseLine or
// ErveDispatch — those remain the immutable historical fulfillment record.
// Returned physical stock is represented instead by a new fact,
// ReturnedStockLot, created only once physical receipt is confirmed.
//
// Lifecycle: SUBMITTED (Distributor request, reserves only against other
// return requests) -> APPROVED (Accountant/Admin finance approval, sets
// approvedQuantity, reserves against Actual Sale reporting too) -> RECEIVED
// (Merchandiser/Admin physical receipt, sets receivedQuantity, creates
// ReturnedStockLot) — or SUBMITTED -> REJECTED / (SUBMITTED|APPROVED) ->
// CANCELLED. REJECTED/RECEIVED/CANCELLED are terminal. Once
// creditNoteReference is recorded, CANCELLED is no longer reachable (a
// credit note must not survive a cancelled business event), and physical
// receipt must exactly match approvedQuantity (a lower receipt after the
// credit note exists would leave it referencing goods Erve never got back —
// no reversal workflow exists yet to reconcile that).
//
// See distributor-return.service.ts / sale-or-return-quantities.ts for the
// full quantity model (receivedQuantity / actualSoldQuantity /
// returnedQuantity / approvedAwaitingReceipt / pendingRequested).
// ---------------------------------------------------------------------------

enum DistributorReturnStatus {
  SUBMITTED
  APPROVED
  REJECTED
  RECEIVED
  CANCELLED
}

model DistributorReturn {
  id                     String                  @id
  returnNumber           String                  @unique @map("return_number")
  distributorId          String                  @map("distributor_id")
  returnDate             DateTime                @map("return_date") @db.Date
  status                 DistributorReturnStatus @default(SUBMITTED)
  returnReason           String                  @map("return_reason")
  remarks                String?
  submittedById          String                  @map("submitted_by_id")
  submittedAt            DateTime                @default(now()) @map("submitted_at")
  approvedById           String?                 @map("approved_by_id")
  approvedAt             DateTime?               @map("approved_at")
  approvalRemarks        String?                 @map("approval_remarks")
  rejectionReason        String?                 @map("rejection_reason")
  receivedById           String?                 @map("received_by_id")
  receivedAt             DateTime?               @map("received_at")
  creditNoteReference    String?                 @map("credit_note_reference")
  creditNoteDate         DateTime?               @map("credit_note_date") @db.Date
  creditNoteRecordedById String?                 @map("credit_note_recorded_by_id")
  cancelledById          String?                 @map("cancelled_by_id")
  cancelledAt            DateTime?               @map("cancelled_at")
  version                Int                     @default(1)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  financialYearId        String                  @map("financial_year_id")
  returnSerial           Int                     @map("return_serial")

  distributor          Distributor             @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  submittedBy          User                    @relation("DistributorReturnSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy           User?                   @relation("DistributorReturnApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  receivedBy           User?                   @relation("DistributorReturnReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  cancelledBy          User?                   @relation("DistributorReturnCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  creditNoteRecordedBy User?                   @relation("DistributorReturnCreditNoteRecorder", fields: [creditNoteRecordedById], references: [id], onDelete: Restrict)
  financialYear        FinancialYear           @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  lines                DistributorReturnLine[]

  @@unique([financialYearId, returnSerial])
  @@index([distributorId])
  @@index([status])
  @@map("distributor_returns")
}

// One row per (erveDispatchId, saleOrderLineId) pair — same granularity as
// DistributorSalesReportLine/ErveDispatchDeliveryLine, so all three share one
// join shape against the sale-or-return position view (see
// sale-or-return-quantities.ts).
model DistributorReturnLine {
  id                  String   @id
  distributorReturnId String   @map("distributor_return_id")
  erveDispatchId      String   @map("erve_dispatch_id")
  saleOrderLineId     String   @map("sale_order_line_id")
  requestedQuantity   Int      @map("requested_quantity")
  approvedQuantity    Int?     @map("approved_quantity")
  receivedQuantity    Int?     @map("received_quantity")
  createdAt           DateTime @default(now()) @map("created_at")

  distributorReturn DistributorReturn @relation(fields: [distributorReturnId], references: [id], onDelete: Cascade)
  erveDispatch      ErveDispatch      @relation(fields: [erveDispatchId], references: [id], onDelete: Restrict)
  saleOrderLine     SaleOrderLine     @relation(fields: [saleOrderLineId], references: [id], onDelete: Restrict)
  returnedStockLot  ReturnedStockLot?

  @@unique([distributorReturnId, erveDispatchId, saleOrderLineId])
  @@index([erveDispatchId, saleOrderLineId])
  @@map("distributor_return_lines")
}

// Created exactly once per DistributorReturnLine, only when that line's
// return is RECEIVED, quantity = receivedQuantity (immutable thereafter — no
// update path exists). A new physical-inventory fact, NOT a QaReleaseLine —
// does not touch/release the original StockAllocation/QaReleaseLine/
// ErveDispatch. Deliberately not yet part of any generic "available stock"
// consumption pool (no ReturnedStockAllocation / RESALE in this phase) — this
// is physically-received returned-stock inventory with full provenance,
// ready for a future RESALE consumption ledger to reference.
model ReturnedStockLot {
  id                      String   @id
  distributorReturnLineId String   @unique @map("distributor_return_line_id")
  saleOrderLineId         String   @map("sale_order_line_id")
  quantity                Int
