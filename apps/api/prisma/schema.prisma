  jobOrder JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  @@unique([jobOrderId, seasonId])
  @@index([seasonId])
  @@map("job_order_season_snapshots")
}

model JobOrderAcknowledgement {
  id                     String    @id
  jobOrderId             String    @map("job_order_id")
  jobOrderVersion        Int       @map("job_order_version")
  disclaimerRevision     Int       @map("disclaimer_revision")
  disclaimerTextSnapshot String    @map("disclaimer_text_snapshot")
  disclaimerSha256       String    @map("disclaimer_sha256")
  factoryIdSnapshot      String    @map("factory_id_snapshot")
  acknowledgedByUserId   String    @map("acknowledged_by_user_id")
  acknowledgedByRole     RoleName  @map("acknowledged_by_role")
  acknowledgedAt         DateTime  @map("acknowledged_at")
  invalidatedAt          DateTime? @map("invalidated_at")
  invalidatedByUserId    String?   @map("invalidated_by_user_id")
  invalidationReason     String?   @map("invalidation_reason")
  invalidationMetadata   Json?     @map("invalidation_metadata")
  createdAt              DateTime  @default(now()) @map("created_at")

  jobOrder       JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  acknowledgedBy User     @relation("JobOrderAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: Restrict)

  @@unique([jobOrderId, jobOrderVersion])
  @@index([jobOrderId, acknowledgedAt])
  @@index([acknowledgedByUserId])
  @@map("job_order_acknowledgements")
