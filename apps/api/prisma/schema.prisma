// A session records the shared inspection cycle and lifecycle only. Every size
// inspected in that cycle has its own complete form below.
model QaInspectionSession {
  id                         String             @id
  jobOrderId                 String             @map("job_order_id")
  inspectorId                String             @map("inspector_id")
  cycleNumber                Int                @map("cycle_number")
  status                     QaInspectionStatus @default(DRAFT)
  version                    Int                @default(1)
  finalizedAt                DateTime?          @map("finalized_at")
  reopenedAt                 DateTime?          @map("reopened_at")
  reopenedById               String?            @map("reopened_by_id")
  reopenReason               String?            @map("reopen_reason")
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")
  qualityActivityExecutionId String?            @unique(map: "qa_inspection_sessions_quality_execution_key") @map("quality_activity_execution_id")

  jobOrder                 JobOrder                  @relation(fields: [jobOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inspector                User                      @relation("QaInspector", fields: [inspectorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reopenedBy               User?                     @relation("QaReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  forms                    QaSizeInspectionForm[]
  evidence                 QaEvidence[]
  qualityActivityExecution QualityActivityExecution? @relation(fields: [qualityActivityExecutionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "qa_inspection_sessions_quality_execution_fkey")

  @@index([jobOrderId, status])
  @@index([inspectorId])
  @@map("qa_inspection_sessions")
}

model QaSizeInspectionChecklistItem {
  id               String             @id
  inspectionFormId String             @map("inspection_form_id")
  itemCode         String             @map("item_code")
  status           QaChecklistStatus?
  remarks          String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  form QaSizeInspectionForm @relation(fields: [inspectionFormId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([inspectionFormId, itemCode], map: "qa_size_inspection_checklist_i_inspection_form_id_item_code_key")
  @@index([inspectionFormId])
  @@map("qa_size_inspection_checklist_items")
}

// One complete paper-equivalent QA form for one JobOrderLineSize in a session.
// DRAFT forms reserve quantities. FINALIZED forms are authoritative.
model QaSizeInspectionForm {
  id                          String             @id
  inspectionSessionId         String             @map("inspection_session_id")
  jobOrderLineSizeId          String             @map("job_order_line_size_id")
  sourceReworkTaskId          String?            @map("source_rework_task_id")
  sampleQuantity              Int?               @map("sample_quantity")
  inspectionRemarks           String?            @map("inspection_remarks")
  status                      QaInspectionStatus @default(DRAFT)
  finalizedAt                 DateTime?          @map("finalized_at")
  reopenedAt                  DateTime?          @map("reopened_at")
  reopenedById                String?            @map("reopened_by_id")
  reopenReason                String?            @map("reopen_reason")
  version                     Int                @default(1)
  inspectedQuantity           Int                @map("inspected_quantity")
  acceptedQuantity            Int                @map("accepted_quantity")
  reworkQuantity              Int                @map("rework_quantity")
  permanentlyRejectedQuantity Int                @map("permanently_rejected_quantity")
  defectCategory              QaDefectCategory?  @map("defect_category")
  otherDefectDetails          String?            @map("other_defect_details")
  defectNotes                 String?            @map("defect_notes")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")

  session          QaInspectionSession             @relation(fields: [inspectionSessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobOrderLineSize JobOrderLineSize                @relation(fields: [jobOrderLineSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceReworkTask QaReworkTask?                   @relation("QaReinspectionSource", fields: [sourceReworkTaskId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  generatedRework  QaReworkTask?                   @relation("QaGeneratedRework")
  checklist        QaSizeInspectionChecklistItem[]
  reopenedBy       User?                           @relation("QaSizeFormReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  evidence         QaEvidence[]

  @@unique([inspectionSessionId, jobOrderLineSizeId])
  // Uniqueness is enforced by the custom COALESCE expression index in
  // 20260729160000_add_qa_workflow so null source IDs are treated as equal.
  @@index([jobOrderLineSizeId])
  @@index([sourceReworkTaskId])
  @@index([inspectionSessionId, status], map: "qa_size_inspection_forms_session_status_idx")
  @@index([reopenedById])
  @@map("qa_size_inspection_forms")
}

model QaReworkTask {
  id                 String         @id
  jobOrderId         String         @map("job_order_id")
  jobOrderLineSizeId String         @map("job_order_line_size_id")
  sourceLineId       String         @unique @map("source_line_id")
  attemptNumber      Int            @map("attempt_number")
  assignedQuantity   Int            @map("assigned_quantity")
  status             QaReworkStatus @default(REWORK_REQUIRED)
  acknowledgedById   String?        @map("acknowledged_by_id")
  acknowledgedAt     DateTime?      @map("acknowledged_at")
  readyById          String?        @map("ready_by_id")
  readyAt            DateTime?      @map("ready_at")
  notes              String?
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  jobOrder         JobOrder               @relation(fields: [jobOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobOrderLineSize JobOrderLineSize       @relation(fields: [jobOrderLineSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceLine       QaSizeInspectionForm   @relation("QaGeneratedRework", fields: [sourceLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reinspections    QaSizeInspectionForm[] @relation("QaReinspectionSource")
  acknowledgedBy   User?                  @relation("QaReworkAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  readyBy          User?                  @relation("QaReworkReadiedBy", fields: [readyById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([jobOrderLineSizeId, attemptNumber])
  @@index([jobOrderId, status])
  @@map("qa_rework_tasks")
}

model QaEvidence {
