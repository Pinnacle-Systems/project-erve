model File {
  id             String   @id
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  storageKey     String   @map("storage_key")
  // SHA-256 of the stored bytes — lets a retried/duplicated upload of the
  // same content be answered with the existing record instead of creating
  // a duplicate style image.
  checksumSha256 String?  @map("checksum_sha256")
  url            String?
  uploadedById   String?  @map("uploaded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  uploadedBy         User?               @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  styleImages        StyleImage[]
  qaEvidence         QaEvidence[]
  qualityAttachments QualityAttachment[]

  @@index([storageKey])
  @@index([uploadedById])
  @@map("files")
}
